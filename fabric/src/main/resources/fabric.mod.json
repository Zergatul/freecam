        "issues": "https://github.com/Zergatul/freecam/issues"
    },
    "license": "MIT",
    "icon": "icon.png",
    "environment": "client",
    "entrypoints": {
        "client": ["com.zergatul.freecam.fabric.ModMain"]
    },
    "mixins": ["freecam.mixins.json"],
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~1.16.5",
        "java": ">=8",
        "fabric": "*"
    }
