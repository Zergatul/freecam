{
  "schemaVersion": 1,
  "id": "zergatulfreecam",
  "version": "${version}",

  "name": "FreeCam",
  "description": "Use F6 to toggle FreeCam, or change key bind in the settings.\nType .freecam in chat to open mod settings.",
  "authors": [
    "Zergatul"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/freecam-by-zergatul",
    "sources": "https://github.com/Zergatul/freecam",
    "issues": "https://github.com/Zergatul/freecam/issues"
  },

  "license": "MIT",
  "icon": "assets/zergatulfreecam/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": ["com.zergatul.freecam.fabric.ModMain"],
    "modmenu": ["com.zergatul.freecam.fabric.ModMenuApiImpl"]
  },
  "mixins": ["freecam.mixins.json"],

  "depends": {
    "fabricloader": ">=0.18.3",
    "minecraft": ">=26.3-",
    "java": ">=25",
    "fabric-api": "*"
  }
}